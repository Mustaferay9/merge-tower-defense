<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MergeTowerDefense</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pure core (no DOM/Pixi/IO) -->
    <Compile Include="Shared.fs" />
    <Compile Include="I18n.fs" />
    <Compile Include="State.fs" />
    <Compile Include="Ui.fs" />
    <!-- Interop boundary -->
    <Compile Include="Interop/Pixi.fs" />
    <Compile Include="Interop/React.fs" />
    <Compile Include="Interop/Dom.fs" />
    <Compile Include="Interop/Audio.fs" />
    <!-- View shells -->
    <Compile Include="View/Render.fs" />
    <Compile Include="View/Hud.fs" />
    <Compile Include="App.fs" />
  </ItemGroup>

</Project>
